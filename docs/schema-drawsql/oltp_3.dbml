Project oltp_3 {
 database_type: 'PostgreSQL'
}

Table products [headercolor: #8b5cf6] {
  id bigint [pk, not null]
  sku "character varying" [unique]
  name "character varying"
  url_key "character varying"
  price numeric(24,6)
  original_price numeric(24,6)
  discount numeric(24,6)
  discount_rate numeric(24,6)
  brand_name "character varying"
  rating_average numeric(24,6)
  review_count integer
  thumbnail_url "character varying"
  category_id integer
  category_name "character varying"
  quantity_sold integer
  crawl_date date
  is_active boolean
  seller_id bigint
  seller_product_id "character varying"
  url_path "character varying"
  inventory_status "character varying"
  stock_item text
  short_description text
  type "character varying"
  cost_price numeric(24,6)
  created_at "timestamp without time zone"
  updated_at "timestamp without time zone"
}

Table customers [headercolor: #3b82f6] {
  id bigint [pk, not null]
  full_name "character varying"
  email "character varying"
  phone_number "character varying"
  gender "character varying"
  date_of_birth date
  province "character varying"
  city "character varying"
  membership_tier "character varying"
  registration_date "timestamp without time zone"
  updated_at "timestamp without time zone"
}

Table channels [headercolor: #3b82f6] {
  id integer [pk, not null]
  channel_name "character varying"
  channel_type "character varying"
}

Table orders [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_code "character varying" [unique]
  customer_id bigint
  seller_id bigint
  channel_id integer
  session_id bigint
  campaign_id integer
  order_status "character varying"
  total_gross_amount numeric(24,6)
  total_discount_amount numeric(24,6)
  shipping_fee numeric(24,6)
  shipping_discount_amount numeric(24,6)
  shipping_promotion_id bigint
  final_amount numeric(24,6)
  shipping_address_id bigint
  created_at "timestamp without time zone"
  completed_at "timestamp without time zone"
  cancelled_at "timestamp without time zone"
  updated_at "timestamp without time zone"
  checkout_id bigint
  cancellation_reason text
}

Table warehouses [headercolor: #10b981] {
  id integer [pk, not null]
  warehouse_code "character varying"
  warehouse_name "character varying"
  province "character varying"
  city "character varying"
  address text
}

Table carriers [headercolor: #10b981] {
  id integer [pk, not null]
  carrier_code "character varying"
  carrier_name "character varying"
}

Table inventory_levels [headercolor: #10b981] {
  id bigint [pk, not null]
  warehouse_id integer
  sku "character varying"
  quantity_on_hand integer
  quantity_reserved integer
  updated_at "timestamp without time zone"
  indexes {
    (warehouse_id, sku) [unique]
  }
}

Table inventory_movements [headercolor: #10b981] {
  id bigint [pk, not null]
  warehouse_id integer
  sku "character varying"
  movement_type "character varying"
  quantity_change integer
  reference_code "character varying"
  movement_date "timestamp without time zone"
}

Table inventory_daily_balance [headercolor: #10b981] {
  id bigint [pk, not null]
  balance_date date
  warehouse_id integer
  sku "character varying"
  quantity_on_hand integer
  quantity_reserved integer
  indexes {
    (balance_date, warehouse_id, sku) [unique]
  }
}

Table shipments [headercolor: #10b981] {
  id bigint [pk, not null]
  order_code "character varying" [unique]
  warehouse_id integer
  carrier_id integer
  tracking_code "character varying" [unique]
  shipment_status "character varying"
  shipping_cost numeric(24,6)
  created_at "timestamp without time zone"
  picked_at "timestamp without time zone"
  delivered_at "timestamp without time zone"
  failed_at "timestamp without time zone"
  in_transit_at "timestamp without time zone"
  returned_at "timestamp without time zone"
}

Table delivery_attempts [headercolor: #10b981] {
  id bigint [pk, not null]
  shipment_id bigint
  attempt_number integer
  result "character varying"
  attempted_at "timestamp without time zone"
  indexes {
    (shipment_id, attempt_number) [unique]
  }
}

Table marketing_campaigns [headercolor: #f59e0b] {
  id integer [pk, not null]
  campaign_code "character varying"
  campaign_name "character varying"
  campaign_type "character varying"
  target_channel_code "character varying"
  budget_amount numeric(24,6)
  start_date date
  end_date date
}

Table sessions [headercolor: #06b6d4] {
  id bigint [pk, not null]
  customer_id bigint
  channel_id integer
  campaign_id integer
  traffic_source "character varying"
  device_type "character varying"
  started_at "timestamp without time zone"
  ended_at "timestamp without time zone"
}

Table page_events [headercolor: #06b6d4] {
  id bigint [pk, not null]
  session_id bigint
  event_type "character varying"
  product_id bigint
  order_id bigint
  event_time "timestamp without time zone"
  search_keyword text
}

Table cart_items [headercolor: #06b6d4] {
  id bigint [pk, not null]
  session_id bigint
  customer_id bigint
  product_id bigint
  quantity integer
  cart_status "character varying"
  added_at "timestamp without time zone"
  closed_at "timestamp without time zone"
}

TableGroup Catalog_Seller [color: #8b5cf6] {
 products
}

TableGroup Customer_Order [color: #3b82f6] {
 customers
 channels
 orders
}

TableGroup Warehouse_Logistics [color: #10b981] {
 warehouses
 carriers
 inventory_levels
 inventory_movements
 inventory_daily_balance
 shipments
 delivery_attempts
}

TableGroup Marketing [color: #f59e0b] {
 marketing_campaigns
}

TableGroup Web_Analytics [color: #06b6d4] {
 sessions
 page_events
 cart_items
}

Ref: cart_items.customer_id > customers.id

Ref: cart_items.product_id > products.id

Ref: cart_items.session_id > sessions.id

Ref: delivery_attempts.shipment_id > shipments.id

Ref: inventory_daily_balance.warehouse_id > warehouses.id

Ref: inventory_levels.warehouse_id > warehouses.id

Ref: inventory_movements.warehouse_id > warehouses.id

Ref: orders.campaign_id > marketing_campaigns.id

Ref: orders.channel_id > channels.id

Ref: orders.customer_id > customers.id

Ref: orders.session_id > sessions.id

Ref: page_events.order_id > orders.id

Ref: page_events.product_id > products.id

Ref: page_events.session_id > sessions.id

Ref: sessions.campaign_id > marketing_campaigns.id

Ref: sessions.channel_id > channels.id

Ref: sessions.customer_id > customers.id

Ref: shipments.carrier_id > carriers.id

Ref: shipments.warehouse_id > warehouses.id