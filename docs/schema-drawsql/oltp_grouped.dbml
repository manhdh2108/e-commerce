Project ecommerce_oltp {
 database_type: 'PostgreSQL'
}
Table categories [headercolor: #8b5cf6] {
  id integer [pk, not null]
  category_name "character varying"
  parent_id integer
  level integer
  slug "character varying"
}

Table sellers [headercolor: #8b5cf6] {
  id bigint [pk, not null]
  seller_name "character varying"
  shop_name "character varying"
  tier "character varying"
  province "character varying"
  city "character varying"
  email "character varying"
  phone "character varying"
  status "character varying"
  created_at "timestamp without time zone"
  updated_at "timestamp without time zone"
}

Table products [headercolor: #8b5cf6] {
  id bigint [pk, not null]
  sku "character varying" [unique]
  name "character varying"
  url_key "character varying"
  price numeric(24,6)
  original_price numeric(24,6)
  discount numeric(24,6)
  discount_rate numeric(24,6)
  brand_name "character varying"
  rating_average numeric(24,6)
  review_count integer
  thumbnail_url "character varying"
  category_id integer
  category_name "character varying"
  quantity_sold integer
  crawl_date date
  is_active boolean
  seller_id bigint
  seller_product_id "character varying"
  url_path "character varying"
  inventory_status "character varying"
  stock_item text
  short_description text
  type "character varying"
  cost_price numeric(24,6)
  created_at "timestamp without time zone"
  updated_at "timestamp without time zone"
}

TableGroup Catalog_Seller [color: #8b5cf6] {
  categories
  sellers
  products
}

Table customers [headercolor: #3b82f6] {
  id bigint [pk, not null]
  full_name "character varying"
  email "character varying"
  phone_number "character varying"
  gender "character varying"
  date_of_birth date
  province "character varying"
  city "character varying"
  membership_tier "character varying"
  registration_date "timestamp without time zone"
  updated_at "timestamp without time zone"
}

Table customer_addresses [headercolor: #3b82f6] {
  id bigint [pk, not null]
  customer_id bigint
  recipient_name "character varying"
  phone "character varying"
  address_detail "character varying"
  ward "character varying"
  district "character varying"
  province "character varying"
  is_default boolean
}

Table channels [headercolor: #3b82f6] {
  id integer [pk, not null]
  channel_name "character varying"
  channel_type "character varying"
}

Table payment_methods [headercolor: #3b82f6] {
  id integer [pk, not null]
  method_name "character varying"
  method_group "character varying"
}

Table checkouts [headercolor: #3b82f6] {
  id bigint [pk, not null]
  checkout_code "character varying" [unique]
  session_id bigint
  customer_id bigint
  created_at "timestamp without time zone"
}

Table checkout_lines [headercolor: #3b82f6] {
  id bigint [pk, not null]
  checkout_id bigint
  cart_item_id bigint [unique]
  order_item_id bigint [unique]
}

Table orders [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_code "character varying" [unique]
  customer_id bigint
  seller_id bigint
  channel_id integer
  session_id bigint
  campaign_id integer
  order_status "character varying"
  total_gross_amount numeric(24,6)
  total_discount_amount numeric(24,6)
  shipping_fee numeric(24,6)
  shipping_discount_amount numeric(24,6)
  shipping_promotion_id bigint
  final_amount numeric(24,6)
  shipping_address_id bigint
  created_at "timestamp without time zone"
  completed_at "timestamp without time zone"
  cancelled_at "timestamp without time zone"
  updated_at "timestamp without time zone"
  checkout_id bigint
  cancellation_reason text
}

Table order_items [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_id bigint
  line_number integer
  product_id bigint
  quantity integer
  list_price numeric(24,6)
  unit_price numeric(24,6)
  discount_amount numeric(24,6)
  net_amount numeric(24,6)
  item_status "character varying"
  commission_rate numeric(24,6)
  commission_category_id integer
  commission_seller_tier "character varying"
  indexes {
    (order_id, line_number) [unique]
  }
}

Table order_item_promotions [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_item_id bigint
  promotion_id bigint
  applied_discount_amount numeric(24,6)
  funded_by "character varying"
}

Table payments [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_id bigint
  payment_method_id integer
  payment_status "character varying"
  paid_amount numeric(24,6)
  transaction_time "timestamp without time zone"
}

Table refunds [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_id bigint
  return_id bigint
  amount numeric(24,6)
  reason "character varying"
  refund_status "character varying"
  requested_at "timestamp without time zone"
  completed_at "timestamp without time zone"
}

Table returns [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_item_id bigint
  quantity integer
  return_reason "character varying"
  refund_amount numeric(24,6)
  status "character varying"
  requested_at "timestamp without time zone"
  refunded_at "timestamp without time zone"
  received_at "timestamp without time zone"
  warehouse_id integer
  approved_at "timestamp without time zone"
  decision_reason text
}

Table product_reviews [headercolor: #3b82f6] {
  id bigint [pk, not null]
  order_item_id bigint [unique]
  product_id bigint
  customer_id bigint
  rating integer
  comment text
  created_at "timestamp without time zone"
}

TableGroup Customer_Order [color: #3b82f6] {
  customers
  customer_addresses
  channels
  payment_methods
  checkouts
  checkout_lines
  orders
  order_items
  order_item_promotions
  payments
  refunds
  returns
  product_reviews
}

Table warehouses [headercolor: #10b981] {
  id integer [pk, not null]
  warehouse_code "character varying"
  warehouse_name "character varying"
  province "character varying"
  city "character varying"
  address text
}

Table carriers [headercolor: #10b981] {
  id integer [pk, not null]
  carrier_code "character varying"
  carrier_name "character varying"
}

Table inventory_levels [headercolor: #10b981] {
  id bigint [pk, not null]
  warehouse_id integer
  sku "character varying"
  quantity_on_hand integer
  quantity_reserved integer
  updated_at "timestamp without time zone"
  indexes {
    (warehouse_id, sku) [unique]
  }
}

Table inventory_movements [headercolor: #10b981] {
  id bigint [pk, not null]
  warehouse_id integer
  sku "character varying"
  movement_type "character varying"
  quantity_change integer
  reference_code "character varying"
  movement_date "timestamp without time zone"
}

Table inventory_daily_balance [headercolor: #10b981] {
  id bigint [pk, not null]
  balance_date date
  warehouse_id integer
  sku "character varying"
  quantity_on_hand integer
  quantity_reserved integer
  indexes {
    (balance_date, warehouse_id, sku) [unique]
  }
}

Table shipments [headercolor: #10b981] {
  id bigint [pk, not null]
  order_code "character varying" [unique]
  warehouse_id integer
  carrier_id integer
  tracking_code "character varying" [unique]
  shipment_status "character varying"
  shipping_cost numeric(24,6)
  created_at "timestamp without time zone"
  picked_at "timestamp without time zone"
  delivered_at "timestamp without time zone"
  failed_at "timestamp without time zone"
  in_transit_at "timestamp without time zone"
  returned_at "timestamp without time zone"
}

Table delivery_attempts [headercolor: #10b981] {
  id bigint [pk, not null]
  shipment_id bigint
  attempt_number integer
  result "character varying"
  attempted_at "timestamp without time zone"
  indexes {
    (shipment_id, attempt_number) [unique]
  }
}

TableGroup Warehouse_Logistics [color: #10b981] {
  warehouses
  carriers
  inventory_levels
  inventory_movements
  inventory_daily_balance
  shipments
  delivery_attempts
}

Table marketing_campaigns [headercolor: #f59e0b] {
  id integer [pk, not null]
  campaign_code "character varying"
  campaign_name "character varying"
  campaign_type "character varying"
  target_channel_code "character varying"
  budget_amount numeric(24,6)
  start_date date
  end_date date
}

Table ad_spend_logs [headercolor: #f59e0b] {
  id bigint [pk, not null]
  campaign_id integer
  channel_code "character varying"
  log_date date
  cost_amount numeric(24,6)
  impressions bigint
  clicks bigint
  indexes {
    (campaign_id, channel_code, log_date) [unique]
  }
}

Table promotions [headercolor: #f59e0b] {
  id bigint [pk, not null]
  promo_code "character varying"
  promo_name "character varying"
  promo_type "character varying"
  seller_id bigint
  apply_level "character varying"
  product_id bigint
  eligibility "character varying"
  discount_type "character varying"
  discount_value numeric(24,6)
  min_order_value numeric(24,6)
  max_discount_amount numeric(24,6)
  usage_limit integer
  per_customer_limit integer
  start_date "timestamp without time zone"
  end_date "timestamp without time zone"
}

Table promotion_usages [headercolor: #f59e0b] {
  id bigint [pk, not null]
  promotion_id bigint
  order_id bigint
  customer_id bigint
  discount_amount numeric(24,6)
  usage_status "character varying"
  created_at "timestamp without time zone"
  released_at "timestamp without time zone"
}

TableGroup Marketing [color: #f59e0b] {
  marketing_campaigns
  ad_spend_logs
  promotions
  promotion_usages
}

Table sessions [headercolor: #06b6d4] {
  id bigint [pk, not null]
  customer_id bigint
  channel_id integer
  campaign_id integer
  traffic_source "character varying"
  device_type "character varying"
  started_at "timestamp without time zone"
  ended_at "timestamp without time zone"
}

Table page_events [headercolor: #06b6d4] {
  id bigint [pk, not null]
  session_id bigint
  event_type "character varying"
  product_id bigint
  order_id bigint
  event_time "timestamp without time zone"
  search_keyword text
}

Table cart_items [headercolor: #06b6d4] {
  id bigint [pk, not null]
  session_id bigint
  customer_id bigint
  product_id bigint
  quantity integer
  cart_status "character varying"
  added_at "timestamp without time zone"
  closed_at "timestamp without time zone"
}

TableGroup Web_Analytics [color: #06b6d4] {
  sessions
  page_events
  cart_items
}

Table seller_commission_rates [headercolor: #ec4899] {
  id integer [pk, not null]
  category_id integer
  seller_tier "character varying"
  commission_rate numeric(24,6)
  effective_from date
  effective_to date
}

Table seller_payouts [headercolor: #ec4899] {
  id bigint [pk, not null]
  seller_id bigint
  period_start date
  period_end date
  gross_sales numeric(24,6)
  refund_amount numeric(24,6)
  commission_amount numeric(24,6)
  payout_amount numeric(24,6)
  payout_status "character varying"
  paid_at "timestamp without time zone"
  indexes {
    (seller_id, period_start, period_end) [unique]
  }
}

Table seller_payout_items [headercolor: #ec4899] {
  id bigint [pk, not null]
  seller_payout_id bigint
  order_item_id bigint [unique]
  gross_amount numeric(24,6)
  refund_amount numeric(24,6)
  commission_amount numeric(24,6)
  net_amount numeric(24,6)
  created_at "timestamp without time zone"
}

TableGroup Finance [color: #ec4899] {
  seller_commission_rates
  seller_payouts
  seller_payout_items
}

Ref: ad_spend_logs.campaign_id > marketing_campaigns.id
Ref: cart_items.customer_id > customers.id
Ref: cart_items.product_id > products.id
Ref: cart_items.session_id > sessions.id
Ref: categories.parent_id > categories.id
Ref: checkout_lines.cart_item_id > cart_items.id
Ref: checkout_lines.checkout_id > checkouts.id
Ref: checkout_lines.order_item_id > order_items.id
Ref: checkouts.customer_id > customers.id
Ref: checkouts.session_id > sessions.id
Ref: customer_addresses.customer_id > customers.id
Ref: delivery_attempts.shipment_id > shipments.id
Ref: inventory_daily_balance.warehouse_id > warehouses.id
Ref: inventory_levels.warehouse_id > warehouses.id
Ref: inventory_movements.warehouse_id > warehouses.id
Ref: order_item_promotions.order_item_id > order_items.id
Ref: order_item_promotions.promotion_id > promotions.id
Ref: order_items.commission_category_id > categories.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: orders.campaign_id > marketing_campaigns.id
Ref: orders.channel_id > channels.id
Ref: orders.checkout_id > checkouts.id
Ref: orders.customer_id > customers.id
Ref: orders.seller_id > sellers.id
Ref: orders.session_id > sessions.id
Ref: orders.shipping_address_id > customer_addresses.id
Ref: orders.shipping_promotion_id > promotions.id
Ref: page_events.order_id > orders.id
Ref: page_events.product_id > products.id
Ref: page_events.session_id > sessions.id
Ref: payments.order_id > orders.id
Ref: payments.payment_method_id > payment_methods.id
Ref: product_reviews.customer_id > customers.id
Ref: product_reviews.order_item_id > order_items.id
Ref: product_reviews.product_id > products.id
Ref: products.category_id > categories.id
Ref: products.seller_id > sellers.id
Ref: promotion_usages.customer_id > customers.id
Ref: promotion_usages.order_id > orders.id
Ref: promotion_usages.promotion_id > promotions.id
Ref: promotions.product_id > products.id
Ref: promotions.seller_id > sellers.id
Ref: refunds.order_id > orders.id
Ref: refunds.return_id > returns.id
Ref: returns.order_item_id > order_items.id
Ref: returns.warehouse_id > warehouses.id
Ref: seller_commission_rates.category_id > categories.id
Ref: seller_payout_items.order_item_id > order_items.id
Ref: seller_payout_items.seller_payout_id > seller_payouts.id
Ref: seller_payouts.seller_id > sellers.id
Ref: sessions.campaign_id > marketing_campaigns.id
Ref: sessions.channel_id > channels.id
Ref: sessions.customer_id > customers.id
Ref: shipments.carrier_id > carriers.id
Ref: shipments.warehouse_id > warehouses.id
